{
  "id": null,
  "uid": "n8n-private",
  "title": "n8n Operations (Tailscale)",
  "description": "Private n8n health, workflow counts and performance from local Prometheus. No secrets or workflow payloads.",
  "tags": [
    "n8n",
    "automation",
    "private"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "n8n Prometheus scrape health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mcp-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"n8n-private\"}",
          "legendFormat": "n8n",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Active workflows",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mcp-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "n8n_active_workflow_count{job=\"n8n-private\"}",
          "legendFormat": "n8n",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "n8n process resident memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mcp-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "n8n_process_resident_memory_bytes{job=\"n8n-private\"}",
          "legendFormat": "n8n",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "n8n process CPU rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mcp-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(n8n_process_cpu_seconds_total{job=\"n8n-private\"}[5m])",
          "legendFormat": "n8n",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "JS event loop lag",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mcp-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "n8n_nodejs_eventloop_lag_seconds{job=\"n8n-private\"}",
          "legendFormat": "n8n",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "n8n workflow duration events",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mcp-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(n8n_workflow_execution_duration_seconds_count{job=\"n8n-private\"}[5m])",
          "legendFormat": "n8n",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  }
}
