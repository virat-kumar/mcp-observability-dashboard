      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "100 * sum by(mcp)(rate(process_cpu_seconds_total{job=\"mcp-tunnels\",mcp=~\"$mcp\"}[5m]))",
