  ],
  "templating": {
    "list": [
      {
        "name": "mcp",
        "label": "MCP",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mcp-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"mcp-tunnels\"}, mcp)",
          "refId": "A"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  }
}
