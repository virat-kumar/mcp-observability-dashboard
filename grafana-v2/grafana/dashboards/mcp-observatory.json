      "title": "P95 end-to-end latency",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mcp-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le,mcp)(rate(command_end_to_end_latency_milliseconds_bucket{latency_type=\"enqueue_to_response\",request_method=\"tools/call\",mcp=~\"$mcp\"}[5m])))",
          "legendFormat": "{{mcp}}",
